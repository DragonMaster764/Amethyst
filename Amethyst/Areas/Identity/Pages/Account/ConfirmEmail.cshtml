@page
@model ConfirmEmailModel
@{
    ViewData["Title"] = "Confirm Email";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card auth-message-card">
            <div class="auth-header">
                <p class="auth-kicker">Email Confirmed</p>
                <h1>Confirm Email</h1>
                <p class="auth-subtext">Your email has been confirmed. You’re ready for the next step.</p>
            </div>

            <div class="status-message-wrap">
                <partial name="_StatusMessage" model="Model.StatusMessage" />
            </div>

            <div class="auth-action-center">
                <form method="get" asp-page="/CreateProfile/UserType">
                    <button type="submit" class="auth-submit-btn auth-submit-btn-inline">Create Profile</button>
                </form>
            </div>
        </div>
    </div>
</div>