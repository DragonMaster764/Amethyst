@page
@model ForgotPasswordConfirmation
@{
    ViewData["Title"] = "Forgot Password Confirmation";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card auth-message-card">
            <div class="auth-header">
                <p class="auth-kicker">Check Your Email</p>
                <h1>Password Reset Sent</h1>
                <p class="auth-subtext">Please check your email for instructions to reset your password.</p>
            </div>

            <div class="auth-links auth-links-centered">
                <a asp-area="Identity" asp-page="/Account/Login">Back to log in</a>
            </div>
        </div>
    </div>
</div>