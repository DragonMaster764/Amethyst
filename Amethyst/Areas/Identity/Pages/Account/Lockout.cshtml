@page
@model LockoutModel
@{
    ViewData["Title"] = "Locked Out";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card auth-message-card">
            <div class="auth-header">
                <p class="auth-kicker">Account Notice</p>
                <h1>Locked Out</h1>
                <p class="auth-subtext">This account has been temporarily locked. Please try again later.</p>
            </div>

            <div class="auth-links auth-links-centered">
                <a asp-area="Identity" asp-page="/Account/Login">Return to log in</a>
            </div>
        </div>
    </div>
</div>