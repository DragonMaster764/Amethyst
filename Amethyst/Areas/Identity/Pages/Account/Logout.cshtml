@page
@model LogoutModel
@{
    ViewData["Title"] = "Log Out";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card auth-message-card">
            <div class="auth-header">
                <p class="auth-kicker">Account</p>
                <h1>Log Out</h1>
            </div>

            @if (User.Identity?.IsAuthenticated ?? false)
            {
                <form class="auth-form" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Page("/", new { area = "" })" method="post">
                    <button type="submit" class="auth-submit-btn">Click Here to Log Out</button>
                </form>
            }
            else
            {
                <p class="auth-subtext auth-centered-text">You have successfully logged out of the application.</p>

                <div class="auth-links auth-links-centered">
                    <a asp-page="/Index">Return Home</a>
                </div>
            }
        </div>
    </div>
</div>