@page
@model ResendEmailConfirmationModel
@{
    ViewData["Title"] = "Resend Email Confirmation";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card">
            <div class="auth-header">
                <p class="auth-kicker">Email Confirmation</p>
                <h1>Resend Confirmation</h1>
                <p class="auth-subtext">Enter your email to send a new confirmation message.</p>
            </div>

            <form method="post" class="auth-form">
                <div asp-validation-summary="All" class="text-danger validation-summary" role="alert"></div>

                <div class="auth-field">
                    <label asp-for="Input.Email" class="auth-label">Email</label>
                    <input asp-for="Input.Email"
                           class="auth-input"
                           aria-required="true"
                           placeholder="name@example.com" />
                    <span asp-validation-for="Input.Email" class="text-danger"></span>
                </div>

                <button type="submit" class="auth-submit-btn">Resend</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}