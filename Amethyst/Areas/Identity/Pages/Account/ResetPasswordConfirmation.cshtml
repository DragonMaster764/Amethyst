@page
@model ResetPasswordConfirmationModel
@{
    ViewData["Title"] = "Reset Password Confirmation";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell">
        <div class="auth-card amethyst-card auth-message-card">
            <div class="auth-header">
                <p class="auth-kicker">Success</p>
                <h1>Password Reset</h1>
                <p class="auth-subtext">Your password has been reset successfully.</p>
            </div>

            <div class="auth-links auth-links-centered">
                <a asp-page="./Login">Click here to log in</a>
            </div>
        </div>
    </div>
</div>