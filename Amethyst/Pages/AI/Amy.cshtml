@page
@model Amethyst.Pages.AmyChatbotModel
@{
    ViewData["Title"] = "Amy";
}

<div class="container py-5" style="max-width: 700px;">

    <div class="text-center mb-4">
        <p class="mb-1">✦</p>
        <h1 class="display-6 fw-medium">Amy</h1>
        <p class="text-muted">Tell me what's going on and I'll help you figure out where to start.</p>
    </div>

    <div class="card border rounded-4 shadow-sm">
        <div class="card-body p-4">
            <form method="post" onsubmit="handleSubmit()">
                <div class="mb-3">
                    <label asp-for="UserInput" class="form-label fw-semibold">What's on your plate right now?</label>
                    <textarea asp-for="UserInput" class="form-control" rows="4"
                              placeholder="e.g. I have a project due tomorrow and two discussion posts, but I don't know what to tackle first..."></textarea>
                    <span asp-validation-for="UserInput" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary btn-lg" id="submitBtn">
                        <span id="btnText">Get My Plan</span>
                        <span id="spinner" class="spinner-border spinner-border-sm d-none" role="status"></span>
                    </button>
                </div>
            </form>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="alert alert-danger mt-3" role="alert">
                    ⚠️ @Model.ErrorMessage
                </div>
            }
        </div>
    </div>

    @if (Model.HasResult)
    {
        <div class="card border rounded-4 shadow-sm mt-4">
            <div class="card-body p-4">
                <h5 class="card-title mb-3">Amy's suggestion</h5>
                <p class="card-text">@Html.Raw(Model.FeedbackResult)</p>
            </div>
        </div>
    }

</div>

<script>
    function handleSubmit() {
        const btn = document.getElementById('submitBtn');
        const txt = document.getElementById('btnText');
        const spin = document.getElementById('spinner');
        btn.disabled = true;
        txt.textContent = 'Getting your plan...';
        spin.classList.remove('d-none');
    }
</script>