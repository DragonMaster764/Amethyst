@page
@model Amethyst.Pages.Admin.StudySongListModel

@{
    ViewData["Title"] = "Study Session Song List";
}

<style>
    body {
        background-color: #0f0c29;
        background: linear-gradient(to right, #24243e, #302b63, #0f0c29);
        color: #eee;
    }
    .glass-card {
        background: rgba(255, 255, 255, 0.1);
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }
    .glass-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        border: 1px solid rgba(0, 255, 255, 0.3);
    }
    .text-neon {
        color: #0ff;
        text-shadow: 0 0 5px #0ff;
    }
    .badge-synth {
        background-color: #ff00ff;
        color: white;
    }
</style>

<div class="container py-5">
    <div class="text-center mb-5">
        <h1 class="display-3 text-neon">Study_Songs</h1>
        <p class="lead">Curated tracks for deep focus and late-night coding.</p>
    </div>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        @foreach (var song in @Model.Songs)
        {
            <div class="col">
                <div class="card h-100 glass-card text-white">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <h4 class="card-title text-neon mb-0">@song.Title</h4>
                            <span class="badge bg-dark border border-secondary">@song.Duration</span>
                        </div>
                        <h6 class="text-info mb-3">@song.Artist</h6>

                        <p class="card-text small text-light opacity-75">@song.Description</p>

                        <div class="mb-3">
                            @foreach (var tag in song.MoodTags)
                            {
                                <span class="badge rounded-pill badge-synth me-1">@tag</span>
                            }
                        </div>

                        <div class="d-flex gap-2 mt-auto">
                            <a href="@song.SpotifySearchUrl" target="_blank" class="btn btn-sm btn-outline-success flex-grow-1">Spotify</a>
                            <a href="@song.YoutubeSearchUrl" target="_blank" class="btn btn-sm btn-outline-danger flex-grow-1">YouTube</a>
                        </div>
                    </div>
                    <div class="card-footer bg-transparent border-top border-secondary d-flex justify-content-between">
                        <span class="small text-muted">@song.Genre</span>
                        <div class="btn-group">
                            <a asp-action="Edit" asp-route-id="@song.Id" class="btn btn-link btn-sm text-warning p-0 me-2">Edit</a>
                            <a asp-action="Delete" asp-route-id="@song.Id" class="btn btn-link btn-sm text-danger p-0">Delete</a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
