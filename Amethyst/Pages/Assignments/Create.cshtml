@page
@model Amethyst.Pages.Assignments.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Assignment</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Assignment.CourseId" class="control-label"></label>
                <select asp-for="Assignment.CourseId" class ="form-control" asp-items="ViewBag.CourseId" ></select>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Assignment.Title" class="control-label"></label>
                <input asp-for="Assignment.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="Assignment.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.Description" class="control-label"></label>
                <input asp-for="Assignment.Description" class="form-control" />
                <span asp-validation-for="Assignment.Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.DueDate" class="control-label"></label>
                <input asp-for="Assignment.DueDate" class="form-control" />
                <span asp-validation-for="Assignment.DueDate" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Assignment.Status" class="control-label"></label>
                <input asp-for="Assignment.Status" class="form-control" aria-required="true"/>
                <span asp-validation-for="Assignment.Status" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Assignment.Priority" class="control-label"></label>
                <input asp-for="Assignment.Priority" class="form-control" aria-required="true"/>
                <span asp-validation-for="Assignment.Priority" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.EstimatedMinutes" class="control-label"></label>
                <input asp-for="Assignment.EstimatedMinutes" class="form-control" />
                <span asp-validation-for="Assignment.EstimatedMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.Points" class="control-label"></label>
                <input asp-for="Assignment.Points" class="form-control" />
                <span asp-validation-for="Assignment.Points" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.TotalPoints" class="control-label"></label>
                <input asp-for="Assignment.TotalPoints" class="form-control" />
                <span asp-validation-for="Assignment.TotalPoints" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.RawPercentage" class="control-label"></label>
                <input asp-for="Assignment.RawPercentage" class="form-control" />
                <span asp-validation-for="Assignment.RawPercentage" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.Grade" class="control-label"></label>
                <input asp-for="Assignment.Grade" class="form-control" />
                <span asp-validation-for="Assignment.Grade" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Assignment.UpdatedTime" class="control-label"></label>
                <input asp-for="Assignment.UpdatedTime" class="form-control" />
                <span asp-validation-for="Assignment.UpdatedTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
