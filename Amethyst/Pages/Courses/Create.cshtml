@page
@model Amethyst.Pages.Courses.CreateModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Course</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Course.Title" class="control-label"></label>
                <input asp-for="Course.Title" class="form-control" aria-required="true"/>
                <span asp-validation-for="Course.Title" class="text-danger"></span>
            </div>
            <div class="form-group">
                <span class="text-danger">*</span>
                <label asp-for="Course.Term" class="control-label"></label>
                <select asp-for="Course.Term" class="form-control" aria-required="true">
                    <option value="">-- Select Term --</option>
                    <option value="Fall">Fall</option>
                    <option value="Winter">Winter</option>
                    <option value="Spring">Spring</option>
                    <option value="Summer">Summer</option>
                </select>
                <span asp-validation-for="Course.Term" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.AcademicYear" class="control-label"></label>
                @* Possibly change below's code *@
                <input asp-for="Course.AcademicYear" type="number" min="1900" max="9999" step="1" placeholder="YYYY" />
                <span asp-validation-for="Course.AcademicYear" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.MeetingTime" class="control-label"></label>
                <input asp-for="Course.MeetingTime" type="time" class="form-control" asp-format="{0:hh\\:mm}" step="60" />
                <span asp-validation-for="Course.MeetingTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.InstructorName" class="control-label"></label>
                <input asp-for="Course.InstructorName" class="form-control" />
                <span asp-validation-for="Course.InstructorName" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Course.ColorLabel" class="control-label"></label>
                <input asp-for="Course.ColorLabel" type="color" class="form-control form-control-color" />
                <span asp-validation-for="Course.ColorLabel" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
