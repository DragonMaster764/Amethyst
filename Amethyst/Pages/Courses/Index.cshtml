@page
@model Amethyst.Pages.Courses.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

@if (!Model.CourseGroups.Any())
{
    <p>No courses found.</p>
}
else
{
    foreach (var group in Model.CourseGroups)
    {
        // Remove the styling later and replace it in CSS
        <div style="border: 2px solid black;" class="course-group" aria-labelledby="group-@group.Term-@group.AcademicYear">
            <h3 id="group-@group.Term-@group.AcademicYear">@group.GroupTitle</h3>

            <table class="table">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Term</th>
                        <th>Academic Year</th>
                        <th>Meeting Time</th>
                        <th>Instructor</th>
                        <th>Color</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var item in group.Courses)
                {
                    <tr>
                        <td>@item.Title</td>
                        <td>@item.Term</td>
                        <td>@item.AcademicYear</td>
                        <td>@item.MeetingTime</td>
                        <td>@item.InstructorName</td>
                        <td>@item.ColorLabel</td>
                        <td>
                            <a asp-page="./Edit" asp-route-id="@item.CourseId">Edit</a> |
                            <a asp-page="./Details" asp-route-id="@item.CourseId">Details</a> |
                            <a asp-page="./Delete" asp-route-id="@item.CourseId">Delete</a>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
}
