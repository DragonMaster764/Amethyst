@page
@model Amethyst.Pages.CreateProfile.ProfileMadeModel

<div class="alert alert-success" role="alert">
    <h4>Your Profile Has Been Created Successfully!</h4>
    <p>You will be redirected to the login page shortly.</p>

</div>

<form id="logoutForm" method="post" asp-page-handler="Logout"></form>

<script>
    // Wait 3 seconds, then submit the logout form
    setTimeout(() => {
        document.getElementById('logoutForm').submit();
    }, 3000);
</script>

