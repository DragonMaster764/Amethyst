@page
@model Amethyst.Pages.CreateProfile.StudentFormModel
@{
    ViewData["Title"] = "Create Student Profile";
}

<link rel="stylesheet" href="~/css/login.css" asp-append-version="true" />

<div class="auth-page">
    <div class="auth-shell auth-shell-wide">
        <div class="auth-card amethyst-card">
            <div class="auth-header">
                <p class="auth-kicker">Create Profile</p>
                <h1>Student Profile</h1>
                <p class="auth-subtext">Tell us a little about how you want to use Amethyst.</p>
            </div>

            <form method="post" class="auth-form">
                <div asp-validation-summary="All" class="text-danger validation-summary"></div>

                <input type="hidden" id="timezoneField" asp-for="InputProfile.Timezone" />

                <div class="auth-field">
                    <label asp-for="InputProfile.DisplayName" class="auth-label">Username</label>
                    <input asp-for="InputProfile.DisplayName" class="auth-input" placeholder="User Name" required />
                    <span asp-validation-for="InputProfile.DisplayName" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="InputProfile.Name" class="auth-label">Name / Nickname</label>
                    <input asp-for="InputProfile.Name" class="auth-input" placeholder="Name / Nickname" required />
                    <span asp-validation-for="InputProfile.Name" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="InputProfile.AcademicYear" class="auth-label">Academic Year</label>
                    <select asp-for="InputProfile.AcademicYear" class="auth-input auth-select">
                        <option value="">Select academic year</option>
                        <option value="Freshman">Freshman</option>
                        <option value="Sophomore">Sophomore</option>
                        <option value="Junior">Junior</option>
                        <option value="Senior">Senior</option>
                        <option value="Graduate">Graduate</option>
                    </select>
                    <span asp-validation-for="InputProfile.AcademicYear" class="text-danger"></span>
                </div>

                <div class="auth-field">
                    <label asp-for="InputProfile.NotificationPreferences" class="auth-label">Notification Preferences</label>
                    <select asp-for="InputProfile.NotificationPreferences" class="auth-input auth-select" required>
                        <option value="">-- Select Preference --</option>
                        <option value="instant">Instant</option>
                        <option value="daily_digest">Daily Digest</option>
                        <option value="urgent-only">Urgent Only</option>
                        <option value="none">No Notifications</option>
                    </select>
                    <span asp-validation-for="InputProfile.NotificationPreferences" class="text-danger"></span>
                </div>

                <div class="auth-info-block">
                    <h3>Quiet Hours</h3>
                    <p>During quiet hours, Amethyst will avoid sending interruptions unless they are important.</p>
                </div>

                <div class="auth-two-col">
                    <div class="auth-field">
                        <label asp-for="InputProfile.QuietHoursStart" class="auth-label">Quiet Hours Start</label>
                        <input asp-for="InputProfile.QuietHoursStart" type="time" class="auth-input" required />
                        <span asp-validation-for="InputProfile.QuietHoursStart" class="text-danger"></span>
                    </div>

                    <div class="auth-field">
                        <label asp-for="InputProfile.QuietHoursEnd" class="auth-label">Quiet Hours End</label>
                        <input asp-for="InputProfile.QuietHoursEnd" type="time" class="auth-input" required />
                        <span asp-validation-for="InputProfile.QuietHoursEnd" class="text-danger"></span>
                    </div>
                </div>

                <button type="submit" class="auth-submit-btn">Create Profile</button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const tzField = document.getElementById("timezoneField");
            if (tzField && !tzField.value) {
                tzField.value = tz;
            }
        });
    </script>
}