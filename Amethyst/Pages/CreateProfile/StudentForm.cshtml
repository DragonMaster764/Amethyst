@page
@model Amethyst.Pages.CreateProfile.StudentFormModel
@{
}

<div class="studentForm">

    <form method="post" class="_studentForm">

        <!-- Show validation errors -->
        <div asp-validation-summary="All" class="text-danger"></div>

        <!-- Hidden timezone field -->
        <input type="hidden" id="timezoneField" asp-for="InputProfile.Timezone" />

        <h6>What would you like your username to be?</h6>
        <input asp-for="InputProfile.DisplayName" placeholder="User Name" required />
        <span asp-validation-for="InputProfile.DisplayName" class="text-danger"></span>
        <br><br>

        <h6>Please type your nickname below:</h6>
        <input asp-for="InputProfile.Name" placeholder="Name / Nickname" required />
        <span asp-validation-for="InputProfile.Name" class="text-danger"></span>
        <br><br>

        <h6>Input your current academic school year:</h6>
        <p><i>Freshman, Sophmor, Junior, or Senior</i></p>
        <input asp-for="InputProfile.AcademicYear" placeholder="Academic Year" />
        <span asp-validation-for="InputProfile.AcademicYear" class="text-danger"></span>
        <br><br>

        <h6>Please select your notification preferences below:</h6>
        <select asp-for="InputProfile.NotificationPreferences" required>
            <option value="">-- Select Preference --</option>
            <option value="instant">Instant</option>
            <option value="daily_digest">Daily Digest</option>
            <option value="urgent-only">Urgent Only</option>
            <option value="none">No Notifications</option>
        </select>
        <span asp-validation-for="InputProfile.NotificationPreferences" class="text-danger"></span>
        <br><br>

        <h6>Quiet Hours</h6>
        <p><i>During quiet hours, you are to not be disturbed...</i></p>

        <h6>When would you like your quiet hours to start?</h6>
        <input asp-for="InputProfile.QuietHoursStart" type="time" required />
        <span asp-validation-for="InputProfile.QuietHoursStart" class="text-danger"></span>
        <br><br>

        <h6>When would you like your quiet hours to end?</h6>
        <input asp-for="InputProfile.QuietHoursEnd" type="time" required />
        <span asp-validation-for="InputProfile.QuietHoursEnd" class="text-danger"></span>
        <br><br>

        <button type="submit" class="account-btn">Okay</button>

    </form>

</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const tz = Intl.DateTimeFormat().resolvedOptions().timeZone;
            const tzField = document.getElementById("timezoneField");
            if (tzField && !tzField.value) {
                tzField.value = tz;
            }
        });
    </script>
}
<style>
    .userType-container {
        text-align: center;
        margin-top: 80px;
    }

    .button-row {
        display: flex;
        justify-content: center;
        gap: 40px;
        margin-top: 40px;
    }

    .account-btn,
    .account-btn:link,
    .account-btn:visited {
        background-color: #7C5BA7;
        padding: 15px 30px;
        font-size: 18px;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: 0.2s ease-in-out;
        text-decoration: none !important; /* override underline */
        color: #FFFDFC !important; /* override blue link color */
        display: inline-block;
    }

        .account-btn:hover {
            background-color: #B9A3E3;
            text-decoration: none !important;
            color: #FFFDFC !important;
        }

</style>









