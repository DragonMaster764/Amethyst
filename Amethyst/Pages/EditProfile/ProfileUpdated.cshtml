<h1 style="text-align:center">Your Profile Has Been Updated!</h1>

<div class="button-row">
    <a class="account-btn" asp-page="/Index">
        Go To Dashboard
    </a>
</div>
<style>
    .userType-container {
        text-align: center;
        margin-top: 80px;
    }

