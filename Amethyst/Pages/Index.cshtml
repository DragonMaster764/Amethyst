@page
@model IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />

@if (Model.IsStudent)
{
    <div class="dashboard-page">

        <!-- Welcome Banner -->
        <section class="dashboard-banner amethyst-panel">
            <div class="dashboard-banner-text">
                <h1>
                    Welcome, @(User.Identity?.Name?.Split('@')[0] ?? "Micah")!
                </h1>
                <p>Let’s make today productive!</p>
            </div>

            <div class="dashboard-banner-action">
                <a href="./AI/Amy" class="amethyst-btn-primary">Chat with Amy</a>
            </div>
        </section>

        <!-- Summary Cards -->
        <section class="dashboard-summary amethyst-panel">
            <div class="summary-grid">

                <div class="summary-card amethyst-card">
                    <h3>Total<br />Assignments</h3>
                    <div class="summary-value">@Model.TotalAssignmentsCount</div>
                    <a href="/Assignments/Index" class="summary-link">View</a>
                </div>

                <div class="summary-card amethyst-card">
                    <h3>Total Tasks Due</h3>
                    <div class="summary-value">@Model.TotalTasksDashboardCount</div>
                    <a href="/Task_Pages/Index" class="summary-link">View</a>
                </div>

                <div class="summary-card amethyst-card courses-summary-card">
                    <h3>Active Courses</h3>

                    @if (Model.ActiveCourses.Any())
                    {
                        <div class="course-pill-list">
                            @foreach (var course in Model.VisibleActiveCourses)
                            {
                                var bgColor = string.IsNullOrWhiteSpace(course.ColorLabel) ? "#e6ddf7" : course.ColorLabel;
                                var textColor = GetContrastTextColor(bgColor);

                                <span class="course-pill"
                                    style="background-color: @bgColor; color: @textColor;">
                                    @course.Title
                                </span>
                            }

                            @if (Model.RemainingActiveCoursesCount > 0)
                            {
                                <span class="course-pill course-pill-more">
                                    +@Model.RemainingActiveCoursesCount more
                                </span>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="summary-empty-text">No courses yet</div>
                    }

                    <a href="/Courses/Index" class="summary-link">View</a>
                </div>

                <div class="summary-card amethyst-card">
                    <h3>Upcoming Study<br />Sessions</h3>

                    @if (Model.UpcomingStudySessions.Any())
                    {
                        <div class="study-session-list">
                            @foreach (var session in Model.UpcomingStudySessions)
                            {
                                <div class="session-pill">
                                    @session.StartTime.ToString("ddd h:mm tt")
                                    @if (session.EndTime.HasValue)
                                    {
                                        <span> - @session.EndTime.Value.ToString("h:mm tt")</span>
                                    }
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="summary-empty-text">No upcoming sessions</div>
                    }

                    <a href="/Study_Session/Index" class="summary-link">View</a>
                </div>

                <div class="summary-card amethyst-card">
                    <h3>Reminders</h3>
                    <div class="summary-value">@Model.ReminderCount</div>
                    <a href="/Reminders/Index" class="summary-link">View</a>
                </div>

                <div class="summary-card amethyst-card progress-card">
                    <h3>Tasks Completed</h3>

                    <div class="progress-circle"
                        style="background: conic-gradient(var(--primary-color) 0% @($"{Model.CompletedTasksPercentage}%"), #eadff7 @($"{Model.CompletedTasksPercentage}%") 100%);">
                        <span>@Model.CompletedTasksPercentage%</span>
                    </div>

                    <p class="progress-caption">@Model.CompletedTasksCount of @Model.TotalTasksCount completed</p>
                </div>

            </div>
        </section>

        <!-- Main Content -->
        <section class="dashboard-main amethyst-panel">
            <div class="dashboard-main-grid">

                <!-- Upcoming Assignments -->
                <div class="dashboard-block amethyst-card task-dashboard-block">
                    <h2>Assignments Due</h2>
                    <div class="task-list">
                        @if (Model.UpcomingAssignments.Any())
                        {
                            @foreach (var assignment in Model.UpcomingAssignments)
                            {
                                <div class="assignment-item lilac-box">
                                    <p><strong>@assignment.Title</strong></p>
                                    <p>@(assignment.Course?.Title ?? "Course")</p>
                                    <p>Due: @(assignment.DueDate?.ToString("M/d/yy h:mm tt") ?? "--")</p>
                                    <a href="/Assignments/Index" class="mini-view">View</a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="assignment-empty-state">
                                <p>No upcoming assignments right now.</p>
                                <a href="/Assignments/Create" class="empty-assignment-btn">Create Assignment</a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Today's Tasks -->
                <div class="dashboard-block amethyst-card task-dashboard-block">
                    <h2>Today’s Tasks</h2>

                    <div class="task-list">
                        @if (Model.TodayTasks.Any())
                        {
                            @foreach (var task in Model.TodayTasks)
                            {
                                <form method="post"
                                    asp-page-handler="CompleteTask"
                                    class="task-row-form">
                                    <input type="hidden" name="taskId" value="@task.TaskId" />

                                    <label class="task-row task-row-clickable">
                                        <input type="checkbox"
                                            class="task-check"
                                            onchange="this.form.submit()" />

                                        <span>
                                            @task.Title
                                            @if (task.DueAt.HasValue)
                                            {
                                                <small class="task-due-inline">
                                                    — @task.DueAt.Value.ToString("M/d h:mm tt")
                                                </small>
                                            }
                                        </span>
                                    </label>
                                </form>
                            }
                        }
                        else
                        {
                            <div class="task-empty-state">
                                <p>No tasks to show right now.</p>
                                <a href="/Task_Pages/Create" class="empty-task-btn">Create Task</a>
                            </div>
                        }
                    </div>
                </div>

                <!-- Study Music -->
                <div class="dashboard-block amethyst-card study-music-card">
                    <div class="study-music-header">
                        <h2>Study Music</h2>
                        <div class="study-music-helper">
                            <p>Need help choosing study music?</p>
                            <a href="~/AI/StudySongChatbot" class="helper-btn">Open Playlist Helper</a>
                        </div>
                    </div>

                    <div class="music-player-mockup">
                        <img src="~/images/spotify-mockup.png" alt="Study playlist player" />
                    </div>
                </div>

            </div>
        </section>

    </div>
}
else if (Model.IsAdmin)
{
    <div class="dashboard-page">
        <section class="dashboard-banner amethyst-panel">
            <div class="dashboard-banner-text">
                <h1>Admin Dashboard</h1>
                <p>This dashboard is still being built.</p>
            </div>
        </section>

        <section class="dashboard-main amethyst-panel">
            <div class="dashboard-block amethyst-card dashboard-placeholder-card">
                <h2>Admin View Placeholder</h2>
                <p>Later this can show user management, system activity, reports, and admin shortcuts.</p>
            </div>
        </section>
    </div>
}
else
{
    <div class="dashboard-page">
        <section class="dashboard-banner amethyst-panel">
            <div class="dashboard-banner-text">
                <h1>Welcome!</h1>
                <p>Your dashboard is still being built.</p>
            </div>
        </section>

        <section class="dashboard-main amethyst-panel">
            <div class="dashboard-block amethyst-card dashboard-placeholder-card">
                <h2>General User Dashboard Placeholder</h2>
                <p>Later this can show tasks, reminders, productivity insights, and personalized tools for regular users.</p>
            </div>
        </section>
    </div>
}

@functions {
    public string GetContrastTextColor(string? hexColor)
    {
        if (string.IsNullOrWhiteSpace(hexColor))
        {
            return "#2f2440";
        }

        var color = hexColor.Trim().TrimStart('#');

        if (color.Length != 6)
        {
            return "#2f2440";
        }

        try
        {
            var r = Convert.ToInt32(color.Substring(0, 2), 16);
            var g = Convert.ToInt32(color.Substring(2, 2), 16);
            var b = Convert.ToInt32(color.Substring(4, 2), 16);

            var luminance = (0.299 * r) + (0.587 * g) + (0.114 * b);

            return luminance > 186 ? "#2f2440" : "#ffffff";
        }
        catch
        {
            return "#2f2440";
        }
    }
}