@page
@model Amethyst.Pages.Reminders.DeleteModel

@{
    ViewData["Title"] = "Clear Reminder";
    var reminderTitle = Model.Reminder.Assignment != null
        ? Model.Reminder.Assignment.Title
        : Model.Reminder.TaskItem != null
            ? Model.Reminder.TaskItem.Title
            : "Reminder";
}

<link rel="stylesheet" href="~/css/reminders.css" asp-append-version="true" />

<div class="reminder-delete-page">
    <div class="reminder-delete-header amethyst-panel">
        <div>
            <p class="delete-kicker">Reminders</p>
            <h1>Clear Reminder</h1>
            <p>This will permanently remove the reminder from your list.</p>
        </div>
    </div>

    <div class="reminder-delete-card amethyst-card">
        <div class="reminder-delete-summary">
            <div class="delete-detail-card">
                <span class="delete-detail-label">Reminder Title</span>
                <h2 class="delete-detail-title">@reminderTitle</h2>
            </div>

            <div class="delete-detail-card">
                <span class="delete-detail-label">Target Type</span>
                <div class="reminder-type-pill @(Model.Reminder.TargetType == "Assignment" ? "assignment-pill" : "task-pill")">
                    @Model.Reminder.TargetType
                </div>
            </div>

            <div class="delete-detail-card">
                <span class="delete-detail-label">Remind At</span>
                <p class="delete-detail-time">@Model.Reminder.RemindAt.ToString("dddd, MMMM d, yyyy")</p>
                <span class="delete-time-pill">@Model.Reminder.RemindAt.ToString("h:mm tt")</span>
            </div>
        </div>

        <form method="post" class="reminder-delete-form">
            <input type="hidden" asp-for="Reminder.ReminderId" />

            <div class="reminder-delete-actions">
                <button type="submit" class="reminder-delete-confirm-btn">Delete Reminder</button>
                <a asp-page="./Index" class="amethyst-btn-secondary reminder-delete-cancel-btn">Back to List</a>
            </div>
        </form>
    </div>
</div>