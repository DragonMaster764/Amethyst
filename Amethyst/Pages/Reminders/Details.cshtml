@page
@model Amethyst.Pages.Reminders.DetailsModel

@{
    ViewData["Title"] = "Reminder Details";
}

<link rel="stylesheet" href="~/css/reminder-details.css" asp-append-version="true" />

<div class="reminder-details-page">
    <div class="reminder-details-header amethyst-panel">
        <div class="reminder-details-header-text">
            <p class="details-kicker">Reminder</p>
            <h1>Reminder Details</h1>
            <p>View your reminder information and linked item.</p>
        </div>

        <div class="reminder-details-header-actions">
            <a asp-page="./Index" class="details-secondary-btn">Back to List</a>
            <a asp-page="./Edit" asp-route-id="@Model.Reminder.ReminderId" class="amethyst-btn-primary">Edit Reminder</a>
        </div>
    </div>

    <section class="reminder-details-card amethyst-card">
        <div class="reminder-details-topbar">
            <div>
                <span class="reminder-type-pill @(Model.Reminder.TargetType == "Assignment" ? "assignment-pill" : "task-pill")">
                    @Model.Reminder.TargetType
                </span>
            </div>

            <div class="reminder-status-chip @Model.ReminderStatus.ToLower()">
                @Model.ReminderStatus
            </div>
        </div>

        <div class="reminder-details-grid">
            <div class="detail-box">
                <span class="detail-label">Linked Item</span>
                <h2 class="detail-title">@Model.ReminderTitle</h2>
            </div>

            <div class="detail-box">
                <span class="detail-label">Reminder Date</span>
                <span class="detail-value">@Model.Reminder.RemindAt.ToString("dddd, MMMM d, yyyy")</span>
            </div>

            <div class="detail-box">
                <span class="detail-label">Reminder Time</span>
                <span class="time-pill">@Model.Reminder.RemindAt.ToString("h:mm tt")</span>
            </div>
        </div>
    </section>
</div>