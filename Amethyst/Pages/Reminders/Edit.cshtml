@page
@model Amethyst.Pages.Reminders.EditModel

@{
    ViewData["Title"] = "Edit Reminder";
}

<link rel="stylesheet" href="~/css/reminder-edit.css" asp-append-version="true" />

<div class="reminder-edit-page">
    <div class="reminder-edit-header amethyst-panel">
        <div class="reminder-edit-header-text">
            <p class="edit-kicker">Reminder</p>
            <h1>Edit Reminder</h1>
            <p>Update the reminder type, linked item, and reminder time.</p>
        </div>

        <div class="reminder-edit-header-actions">
            <a asp-page="./Index" class="edit-secondary-btn">Back to List</a>
        </div>
    </div>

    <section class="reminder-edit-card amethyst-card">
        <form method="post" class="reminder-edit-form">
            <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

            <input type="hidden" asp-for="Reminder.ReminderId" />

            <div class="edit-field">
                <label for="targetTypeSelect">Target Type</label>
                <select asp-for="Reminder.TargetType"
                        asp-items="Model.TargetTypeOptions"
                        class="amethyst-select"
                        id="targetTypeSelect">
                </select>
                <span asp-validation-for="Reminder.TargetType" class="text-danger"></span>
            </div>

            <div class="edit-field" id="assignmentField">
                <label asp-for="Reminder.AssignmentId">Assignment</label>
                <select asp-for="Reminder.AssignmentId"
                        asp-items="Model.AssignmentOptions"
                        class="amethyst-select">
                    <option value="">Select an assignment</option>
                </select>
                <span asp-validation-for="Reminder.AssignmentId" class="text-danger"></span>
            </div>

            <div class="edit-field" id="taskField">
                <label asp-for="Reminder.TaskId">Task</label>
                <select asp-for="Reminder.TaskId"
                        asp-items="Model.TaskOptions"
                        class="amethyst-select">
                    <option value="">Select a task</option>
                </select>
                <span asp-validation-for="Reminder.TaskId" class="text-danger"></span>
            </div>

            <div class="edit-field">
                <label asp-for="Reminder.RemindAt">Reminder Time</label>
                <input asp-for="Reminder.RemindAt"
                       type="datetime-local"
                       class="amethyst-input"
                       step="60"
                       value="@Model.Reminder.RemindAt.ToString("yyyy-MM-ddTHH:mm")" />
                <span asp-validation-for="Reminder.RemindAt" class="text-danger"></span>
            </div>

            <div class="reminder-edit-actions">
                <a asp-page="./Index" class="edit-cancel-btn">Cancel</a>
                <button type="submit" class="amethyst-btn-primary">Save Changes</button>
            </div>
        </form>
    </section>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}

    <script>
        function toggleReminderTargetFields() {
            const targetType = document.getElementById("targetTypeSelect").value;
            const assignmentField = document.getElementById("assignmentField");
            const taskField = document.getElementById("taskField");

            if (targetType === "Assignment") {
                assignmentField.style.display = "flex";
                taskField.style.display = "none";
            } else if (targetType === "Task") {
                assignmentField.style.display = "none";
                taskField.style.display = "flex";
            } else {
                assignmentField.style.display = "none";
                taskField.style.display = "none";
            }
        }

        document.addEventListener("DOMContentLoaded", function () {
            const targetTypeSelect = document.getElementById("targetTypeSelect");
            toggleReminderTargetFields();

            if (targetTypeSelect) {
                targetTypeSelect.addEventListener("change", toggleReminderTargetFields);
            }
        });
    </script>
}