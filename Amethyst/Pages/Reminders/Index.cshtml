@page
@model Amethyst.Pages.Reminders.IndexModel

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Reminder[0].TargetType)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reminder[0].RemindAt)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reminder[0].Profile)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reminder[0].Assignment)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Reminder[0].Task)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model.Reminder) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TargetType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.RemindAt)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Profile.ProfileId)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Assignment.Priority)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Task.TaskId)
            </td>
            <td>
                <a asp-page="./Edit" asp-route-id="@item.ReminderId">Edit</a> |
                <a asp-page="./Details" asp-route-id="@item.ReminderId">Details</a> |
                <a asp-page="./Delete" asp-route-id="@item.ReminderId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
