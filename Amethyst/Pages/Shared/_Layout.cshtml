@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
<!DOCTYPE html>
<html lang="en">
<head>
    <base href="~/" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Amethyst</title>
    <link rel="icon" type="image/png" href="~/favicon.png" asp-append-version="true" />
    <link rel="shortcut icon" href="~/favicon.png" asp-append-version="true" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;500;600;700;800&family=Quicksand:wght@400;500;600;700&display=swap" rel="stylesheet">    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Amethyst.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg amethyst-navbar">
            <div class="container amethyst-navbar-inner">

                <!-- Brand / Logo -->
                <a class="navbar-brand amethyst-brand" asp-area="" asp-page="/Index">
                    <img src="~/images/amethyst-logo.png" alt="Amethyst logo" class="amethyst-logo" />
                    <span>Amethyst</span>
                </a>

                <!-- Mobile Toggle -->
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#amethystNavbar"
                        aria-controls="amethystNavbar" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <!-- Navbar Content -->
                <div class="collapse navbar-collapse" id="amethystNavbar">

                    <ul class="navbar-nav amethyst-nav-links mx-auto">

                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-page="/Index">Dashboard</a>
                        </li>

                        @if (User.IsInRole("Admin"))
                        {
                            <li class="dropdown nav-item">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Admin
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="adminDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/UserList">View All Users</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Admin/StudySongList">View Study Music</a></li>
                                </ul>
                            </li>
                        }

                        @if (User.IsInRole("Student"))
                        {
                            <li class="dropdown nav-item">
                                <a class="nav-link dropdown-toggle" href="#" id="workItemsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    View Work Items
                                </a>
                                <ul class="dropdown-menu" aria-labelledby="workItemsDropdown">
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Assignments/Index">View Assignments</a></li>
                                    <li><a class="dropdown-item" asp-area="" asp-page="/Task_Pages/Index">View Tasks</a></li>
                                </ul>
                            </li>

                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Courses/Index">My Courses</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Reminders/Index">Reminders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Study_Session/Index">Study Sessions</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="">Statistics</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="">My Profile</a>
                            </li>
                        }

                        @if (User.IsInRole("User"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Task_Pages/Index">View Tasks</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="/Reminders/Index">Reminders</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="">Statistics</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-page="">My Profile</a>
                            </li>
                        }
                    </ul>

                        @if (User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link text-dark" asp-area="Identity" asp-page="/Account/Logout">Logout</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - Amethyst - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <partial name="_ValidationScriptsPartial" />
</body>
</html>