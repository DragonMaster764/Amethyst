@page
@model Amethyst.Pages.Study_Session.DeleteModel

@{
    ViewData["Title"] = "Delete Study Session";
}

<link rel="stylesheet" href="~/css/study-session-delete.css" asp-append-version="true" />

<div class="study-session-delete-page">
    <div class="delete-header amethyst-panel">
        <div class="delete-header-text">
            <p class="delete-kicker">Delete Study Session</p>
            <h1>Delete Session</h1>
            <p class="delete-subtext">Review this study session before permanently removing it.</p>
        </div>

        <div class="delete-header-actions">
            <a asp-page="./Index" class="delete-secondary-btn">Back to Sessions</a>
        </div>
    </div>

    <div class="delete-warning-banner">
        Are you sure you want to delete this study session? This action cannot be undone.
    </div>

    <section class="delete-session-card amethyst-card @(Model.IsPastSession ? "past-session" : "upcoming-session")">
        <div class="delete-session-topbar">
            <div class="delete-session-title-wrap">
                <p class="session-kicker">Course</p>
                <h2 class="session-course">
                    @(Model.StudySession.Course != null ? Model.StudySession.Course.Title : "General Study Session")
                </h2>
            </div>

            <div class="session-status-chip @(Model.IsPastSession ? "past-chip" : "upcoming-chip")">
                @(Model.IsPastSession ? "Past Session" : "Upcoming Session")
            </div>
        </div>

        <div class="delete-session-details">
            <div class="detail-box time-detail-box">
                <div class="time-box-layout">
                    <div class="time-box-left">
                        <span class="detail-label detail-label-strong">Start Time</span>
                        <span class="time-date">@Model.StudySession.StartTime.ToString("dddd, MMMM d, yyyy")</span>
                    </div>

                    <div class="time-box-right">
                        <span class="time-box-caption">Begins</span>
                        <span class="time-pill large">@Model.StudySession.StartTime.ToString("h:mm tt")</span>
                    </div>
                </div>
            </div>

            <div class="detail-box time-detail-box">
                @if (Model.StudySession.EndTime.HasValue)
                {
                    <div class="time-box-layout">
                        <div class="time-box-left">
                            <span class="detail-label detail-label-strong">End Time</span>
                            <span class="time-date">@Model.StudySession.EndTime.Value.ToString("dddd, MMMM d, yyyy")</span>
                        </div>

                        <div class="time-box-right">
                            <span class="time-box-caption">Ends</span>
                            <span class="time-pill large">@Model.StudySession.EndTime.Value.ToString("h:mm tt")</span>
                        </div>
                    </div>
                }
                else
                {
                    <span class="detail-label detail-label-strong">End Time</span>
                    <span class="detail-value">No end time set</span>
                }
            </div>

            <div class="detail-box">
                <span class="detail-label detail-label-strong">Planned Minutes</span>
                <span class="detail-value">
                    @(Model.StudySession.PlannedMinutes.HasValue ? $"{Model.StudySession.PlannedMinutes} minutes" : "Not set")
                </span>
            </div>

            <div class="detail-box">
                <span class="detail-label detail-label-strong">Actual Minutes</span>
                <span class="detail-value">
                    @(Model.StudySession.ActualMinutes.HasValue ? $"{Model.StudySession.ActualMinutes} minutes" : "Not entered yet")
                </span>
            </div>

            <div class="detail-box">
                <span class="detail-label detail-label-strong">Session Length</span>
                <span class="detail-value">
                    @(Model.SessionLengthMinutes.HasValue ? $"{Model.SessionLengthMinutes} minutes" : "Not available")
                </span>
            </div>
        </div>

        <div class="delete-session-notes">
            <div class="notes-header-row">
                <span class="detail-label detail-label-strong">Session Notes</span>
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.StudySession.Notes))
            {
                <div class="notes-display">
                    @Model.StudySession.Notes
                </div>
            }
            else
            {
                <p class="notes-empty">No notes were added for this study session.</p>
            }
        </div>

        <div class="delete-card-actions">
            <form method="post" asp-route-id="@Model.StudySession.SessionId" class="delete-form">
                <input type="hidden" asp-for="StudySession.SessionId" />
                <button type="submit" class="delete-session-btn">Delete Session</button>
            </form>
        </div>
    </section>
</div>