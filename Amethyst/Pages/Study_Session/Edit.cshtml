                <span asp-validation-for="StudySession.PlannedMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudySession.ActualMinutes" class="control-label"></label>
                <input asp-for="StudySession.ActualMinutes" class="form-control" />
                <span asp-validation-for="StudySession.ActualMinutes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudySession.Notes" class="control-label"></label>
                <input asp-for="StudySession.Notes" class="form-control" />
                <span asp-validation-for="StudySession.Notes" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

