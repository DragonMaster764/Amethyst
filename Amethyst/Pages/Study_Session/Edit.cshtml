@page
@model Amethyst.Pages.Study_Session.EditModel

@{
    ViewData["Title"] = "Edit Study Session";
}

<link rel="stylesheet" href="~/css/study_session_edit.css" asp-append-version="true" />

<div class="study-edit-page">
    <div class="study-edit-header amethyst-panel">
        <div>
            <p class="edit-kicker">Study Sessions</p>
            <h1>Edit Study Session</h1>
            <p>Update the course and scheduled time for this study session.</p>
        </div>
    </div>

    <div class="study-edit-card amethyst-card">
        <form method="post" class="study-edit-form">
            <input type="hidden" asp-for="StudySession.SessionId" />
            <input type="hidden" asp-for="StudySession.ProfileId" />

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-grid">
                <div class="form-field full-width">
                    <label asp-for="StudySession.CourseId" class="form-label">Course</label>
                    <select asp-for="StudySession.CourseId" asp-items="Model.CourseOptions" class="form-select">
                        <option value="">Select a course</option>
                    </select>
                    <span asp-validation-for="StudySession.CourseId" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="StudySession.StartTime" class="form-label">Start Time</label>
                    <input asp-for="StudySession.StartTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="StudySession.StartTime" class="text-danger"></span>
                </div>

                <div class="form-field">
                    <label asp-for="StudySession.EndTime" class="form-label">End Time</label>
                    <input asp-for="StudySession.EndTime" class="form-control" type="datetime-local" />
                    <span asp-validation-for="StudySession.EndTime" class="text-danger"></span>
                </div>
            </div>

            <div class="study-edit-actions">
                <button type="submit" class="amethyst-btn-primary action-btn">Save</button>
                <a asp-page="./Index" class="amethyst-btn-secondary action-btn back-btn">Back to List</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}