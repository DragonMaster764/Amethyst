@page
@model Amethyst.Pages.Study_Session.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>StudySession</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="StudySession.SessionId" />
            <div class="form-group">
                <label asp-for="StudySession.ProfileId" class="control-label"></label>
                <select asp-for="StudySession.ProfileId" class="form-control" asp-items="ViewBag.ProfileId" ></select>
                <span asp-validation-for="StudySession.ProfileId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudySession.CourseId" class="control-label"></label>
                <select asp-for="StudySession.CourseId" class="form-control" asp-items="ViewBag.CourseId" ></select>
                <span asp-validation-for="StudySession.CourseId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudySession.StartTime" class="control-label"></label>
                <input asp-for="StudySession.StartTime" class="form-control" />
                <span asp-validation-for="StudySession.StartTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StudySession.EndTime" class="control-label"></label>
                <input asp-for="StudySession.EndTime" class="form-control" />
                <span asp-validation-for="StudySession.EndTime" class="text-danger"></span>
