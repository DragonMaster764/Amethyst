@page
@model Amethyst.Pages.Task_Pages.IndexModel

@{
    ViewData["Title"] = "Tasks";
}

<link rel="stylesheet" href="~/css/tasks.css" asp-append-version="true" />

<div class="tasks-page">

    <!-- Header -->
    <section class="tasks-header amethyst-panel">
        <div class="tasks-header-text">
            <h1>Tasks</h1>
            <p>Manage your daily to-dos, priorities, and progress.</p>
        </div>

        <div class="tasks-header-action">
            <a asp-page="Create" class="amethyst-btn-primary">Create New</a>
        </div>
    </section>

    <!-- Summary -->
    <section class="tasks-summary amethyst-panel">
        <div class="tasks-summary-grid">
            <div class="tasks-stat amethyst-card">
                <h3>Total Tasks</h3>
                <div class="tasks-stat-value">@Model.TaskItems.Count</div>
            </div>

            <div class="tasks-stat amethyst-card">
                <h3>Completed</h3>
                <div class="tasks-stat-value">
                    @Model.TaskItems.Count(t => t.Status != null && t.Status.ToLower() == "completed")
                </div>
            </div>

            <div class="tasks-stat amethyst-card">
                <h3>Due Soon</h3>
                <div class="tasks-stat-value">
                    @Model.TaskItems.Count(t => t.DueAt.HasValue && t.DueAt.Value >= DateTime.Now && t.DueAt.Value <= DateTime.Now.AddDays(7))
                </div>
            </div>

            <div class="tasks-stat amethyst-card">
                <h3>High Priority</h3>
                <div class="tasks-stat-value">
                    @Model.TaskItems.Count(t => t.Priority != null && t.Priority.ToLower() == "high")
                </div>
            </div>
        </div>
    </section>

    <!-- Table -->
    <section class="tasks-table-panel amethyst-panel">
        <div class="tasks-table-card amethyst-card">
            <div class="table-responsive">
                <table class="tasks-table">
                    <thead>
                        <tr>
                            <th>Title</th>
                            <th>Due</th>
                            <th>Status</th>
                            <th>Priority</th>
                            <th>Time</th>
                            <th>Created</th>
                            <th>Updated</th>
                            @* <th>Profile</th> *@
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model.TaskItems)
                    {
                        <tr>
                            <td class="task-title-cell">
                                <span class="task-title">@item.Title</span>
                            </td>

                            <td>
                                <span class="info-pill">
                                    @(item.DueAt.HasValue ? item.DueAt.Value.ToString("M/d/yy h:mm tt") : "--")
                                </span>
                            </td>

                            <td>
                                <span class="status-badge @GetStatusClass(item.Status)">
                                    @item.Status
                                </span>
                            </td>

                            <td>
                                <span class="priority-badge @GetPriorityClass(item.Priority)">
                                    @item.Priority
                                </span>
                            </td>

                            <td>
                                @(item.EstimatedMinutes?.ToString() ?? "--") min
                            </td>

                            <td>
                                @item.CreatedAt.ToString("M/d/yy")
                            </td>

                            <td>
                                @item.UpdatedAt.ToString("M/d/yy")
                            </td>

                            @* <td>
                                <span class="profile-chip">
                                    @(item.Profile?.DisplayName ?? "--")
                                </span>
                            </td> *@

                            <td>
                                <div class="task-actions">
                                    <a asp-page="./Edit" asp-route-id="@item.TaskId" class="table-action-link">Edit</a>
                                    <a asp-page="./Details" asp-route-id="@item.TaskId" class="table-action-link">Details</a>
                                    <a asp-page="./Delete" asp-route-id="@item.TaskId" class="table-action-link delete-link">Delete</a>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>

@functions {
    public string GetStatusClass(string? status)
    {
        return status?.ToLower() switch
        {
            "completed" => "status-completed",
            "in progress" => "status-progress",
            "not started" => "status-not-started",
            "missing" => "status-missing",
            _ => "status-default"
        };
    }

    public string GetPriorityClass(string? priority)
    {
        return priority?.ToLower() switch
        {
            "high" => "priority-high",
            "medium" => "priority-medium",
            "low" => "priority-low",
            _ => "priority-default"
        };
    }
}